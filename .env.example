# Website/API server
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-characters
GEMINI_API_KEY=

# Comma-separated dashboard origins allowed to call the API directly.
ADMIN_ORIGINS=https://admin.example.com

# One-time administrator bootstrap. Remove the password after first successful start.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-12-plus-character-password-123
ADMIN_BOOTSTRAP_NAME=مدیر سامانه
ADMIN_BOOTSTRAP_PHONE=09000000000

# Leave empty when /api is reverse-proxied on the dashboard domain (recommended).
VITE_ADMIN_API_URL=
